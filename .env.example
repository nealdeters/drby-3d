# DRBY 3D — copy to .env.local for local dev. Do not commit real keys.
# Same live backend as https://drby-live.netlify.app + drby_scheduler.

# Production (Netlify): leave VITE_API_BASE UNSET.
# The app defaults to same-origin /live-api, which netlify.toml proxies to
# https://drby-live.netlify.app/.netlify/functions/* (avoids CORS).
#
# Local direct calls (optional): set to the live host so apiClient uses
# ${VITE_API_BASE}/.netlify/functions
# VITE_API_BASE=https://drby-live.netlify.app

# Realtime defaults to the desktop Centrifugo house bus.
VITE_REALTIME_TRANSPORT=house_bus
# Browser WebSocket endpoint; use ws://100.67.34.26:8002/connection/websocket on Tailscale.
VITE_HOUSE_BUS_WS_URL=
# Token mint endpoint (same-origin Netlify function by default).
VITE_HOUSE_BUS_TOKEN_URL=
# Rollback only: VITE_REALTIME_TRANSPORT=ably plus the old key.
VITE_ABLY_API_KEY=

# REST x-api-key header (same API_KEY / VITE_API_KEY as live). Required for authenticated reads.
VITE_API_KEY=
