# DRBY 3D — environment placeholders
# Live race / season data will plug into the same backend as nealdeters/drby.
# Do not commit real keys. Copy to .env.local for local development.

# Ably realtime (race progress, countdown, presence) — leave empty until wired
VITE_ABLY_API_KEY=

# REST API base URL (same service as the existing DRBY client)
VITE_API_BASE=https://api.example.com

# Optional API key / bearer for authenticated admin or profile calls
VITE_API_KEY=
