# DRBY 3D — copy to .env.local for local dev. Do not commit real keys.
# Same live backend as https://drby-live.netlify.app + drby_scheduler.

# Site origin (functions resolve to ${VITE_API_BASE}/.netlify/functions)
VITE_API_BASE=https://drby-live.netlify.app

# Ably realtime — race:{raceId} channel, event race-update
# Copy the same VITE_ABLY_API_KEY from the live Netlify site (drby-live) env.
VITE_ABLY_API_KEY=

# REST x-api-key header (same API_KEY / VITE_API_KEY as live). Required for authenticated reads.
VITE_API_KEY=
